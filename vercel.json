{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "env": {
    "NEXT_PUBLIC_API_URL": {
      "description": "Public API URL for the application"
    }
  },
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  }
}
